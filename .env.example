# Provider: mock (default, offline) | openai | bedrock
RAG_PROVIDER=mock

# Optional OpenAI-compatible endpoint (only used when RAG_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional AWS Bedrock (only used when RAG_PROVIDER=bedrock; stubs without creds)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Retrieval
RAG_TOP_K=3
RAG_CORPUS_DIR=data/corpus
